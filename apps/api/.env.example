# Clasp API / indexer configuration. Copy to .env and fill in.
# Every variable is documented in docs/RUNBOOK.md.

DATABASE_URL=postgres://user:password@localhost:5432/clasp
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
LOG_LEVEL=info

# HTTP role
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
SITE_URL=http://localhost:3000

# Google login with custodial wallets (all four or none)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
CUSTODY_MASTER_KEY=

# Indexer role
START_BLOCK=
CONFIRMATIONS=20
LOG_RANGE=50000
POLL_MS=3000
RECONCILE_MS=60000
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Keeper (runs inside the indexer)
KEEPER_PRIVATE_KEY=
KEEPER_MIN_BALANCE_WEI=2000000000000000
HARVEST_THRESHOLD_WEI=1000000000000000
TREASURY_CLAIM_THRESHOLD_WEI=10000000000000000
UNLOCKS_PER_TICK=10
UNLOCK_MAX_GAS=500000

# Local forks only: override the addresses published in @clasp/sdk
CLASP_FACTORY_ADDRESS=
CLASP_ROUTER_ADDRESS=
CLASP_LAUNCHER_ADDRESS=
