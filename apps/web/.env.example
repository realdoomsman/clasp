# Public build-time settings for the Clasp website. All values end up in the
# browser bundle; never put a secret here.

# Read API (apps/api). Default: https://api.clasp.fun
NEXT_PUBLIC_API_URL=http://localhost:4000
# Robinhood Chain RPC. Default: https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Canonical site URL used for metadata / Open Graph. Default: https://clasp.fun
NEXT_PUBLIC_SITE_URL=http://localhost:3000
